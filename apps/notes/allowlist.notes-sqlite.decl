aegis-allowlist-decl v1
adapter notes-sqlite
family sqlite
# apps/notes on SQLite. Fields: 0 tenant (host-bound), 1 id (key), 2 body.
# Regenerate the lock with: cargo xtask allowlist-lock --emit apps/notes/allowlist.notes-sqlite.decl
schema notes tenant=0 key=1 cols=0,1,2 permitted=1,2

op notes select eq(1) w=- r=1,2
op notes insert tt w=1,2 r=-
op notes update eq(1) w=2 r=1
op notes upsert tt w=1,2 r=-
op notes delete eq(1) w=- r=1
