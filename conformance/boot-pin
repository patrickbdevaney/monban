#!/usr/bin/env -S python3 -I
"""AEGIS conformance boot record (P8-conformance-001; PREFLIGHT D-P8.5 config-pin).

Usage:
  conformance/boot-pin --subject <name> --binary <aegis> [--config <f8.json>] [--timeout S]
  conformance/boot-pin --self-test

It boots the judged artifact once with the subject's golden F8 config and prints one evidence line that
conformance/run --config-pin reads from this run's gate logs:

  CONFORMANCE-BOOT: <subject> artifact <sha256 of the binary> config <effective-config hash> (...)

The effective-config hash is aegis-config's config_hash (SHA-256 of the canonical effective F8 JSON; defaults are
not part of the hashed form). The line is printed only when three sources agree; any disagreement, a boot failure or
a timeout exits 1 with BOOT-PIN: FAIL:
  1. `<aegis> check-config <cfg>` exits 0 and its stderr has exactly one `OK (config hash H)`;
  2. the booted process logs `aegis[<pid>]: serving ... config H (generation N)` with <pid> the process we started;
  3. its admin `/healthz` reports exactly one `"config_hash":"H"`.
(`--print-effective` is not used as a source: it dumps the config with defaults filled in, which is not the hashed
form.)
--config defaults to the subject's `config` in conformance/config-pin.toml; the pinned hash there is NOT consulted
(conformance/run compares the record against the pin, so a drifted config is reported, never silently re-pinned).
The TLS key and certificate are a throwaway ECDSA P-256 pair minted with openssl in a temp dir (removed afterwards); they
are command-line options, not part of the config, so they do not change H. Only the process this script started is
signalled (SIGTERM, then SIGKILL after 10 s).

--self-test runs the same code against a stand-in subject (conformance/testdata/fake-aegis, a stdlib-Python
imitation of the aegis CLI contract above) and requires: the honest stand-in yields the line; a stand-in whose
/healthz hash, boot-line hash, boot-line pid, check-config hash, check-config line count or exit status disagrees each
yields BOOT-PIN: FAIL and no CONFORMANCE-BOOT line.
"""

import argparse
import hashlib
import http.client
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import tomllib

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PINS = os.path.join(ROOT, "conformance", "config-pin.toml")
FAKE = os.path.join(ROOT, "conformance", "testdata", "fake-aegis")
HEX64 = r"[0-9a-f]{64}"
OPENSSL = shutil.which("openssl") or "/usr/bin/openssl"


class Fail(Exception):
    pass


def sha256_file(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def golden_config(subject):
    try:
        pins = tomllib.load(open(PINS, "rb"))
        rel = pins["subject"][subject]["config"]
    except (OSError, KeyError, TypeError, tomllib.TOMLDecodeError) as e:
        raise Fail(f"no golden config for {subject} in {os.path.relpath(PINS, ROOT)} ({e!r})")
    return rel if os.path.isabs(rel) else os.path.join(ROOT, rel)


def admin_port(cfg_path):
    doc = json.load(open(cfg_path))
    m = re.fullmatch(r"127\.0\.0\.1:(\d+)", (doc.get("admin") or {}).get("bind", ""))
    if not m:
        raise Fail("golden config needs admin.bind 127.0.0.1:<port>")
    return int(m[1])


def healthz(port, timeout=2):
    c = http.client.HTTPConnection("127.0.0.1", port, timeout=timeout)
    try:
        c.request("GET", "/healthz")
        r = c.getresponse()
        return r.status, r.read().decode("utf-8", "replace")
    finally:
        c.close()


def mint(d):
    key, crt = os.path.join(d, "key.pem"), os.path.join(d, "cert.pem")
    p = subprocess.run([OPENSSL, "req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:prime256v1", "-nodes",
                        "-keyout", key, "-out", crt, "-days", "2", "-subj", "/CN=aegis.test",
                        "-addext", "subjectAltName=DNS:aegis.test"], capture_output=True, text=True, timeout=60)
    if p.returncode != 0:
        raise Fail(f"openssl could not mint the throwaway certificate: {p.stderr.strip()[-200:]}")
    return crt, key


def check_config(binary, cfg):
    p = subprocess.run([binary, "check-config", cfg], capture_output=True, timeout=60)
    err = p.stderr.decode("utf-8", "replace")
    if p.returncode != 0:
        raise Fail(f"check-config exit {p.returncode}: {err.strip()[-200:]}")
    m = re.findall(rf"OK \(config hash ({HEX64})\)", err)
    if len(m) != 1:
        raise Fail(f"check-config stderr has {len(m)} 'OK (config hash ...)' lines")
    return m[0]


def boot(binary, cfg, port, timeout):
    d = tempfile.mkdtemp(prefix="aegis-boot-pin-")
    proc = None
    try:
        crt, key = mint(d)
        os.makedirs(os.path.join(d, "audit"))
        env = {k: v for k, v in os.environ.items() if k not in ("NOTIFY_SOCKET", "AEGIS_UPGRADE_DIR", "LISTEN_FDS",
                                                                 "LISTEN_PID", "LISTEN_FDNAMES")}
        proc = subprocess.Popen([binary, "--config", cfg, "--cert", crt, "--key", key,
                                 "--audit-dir", os.path.join(d, "audit")],
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env)
        out, lock = [], threading.Lock()

        def pump():
            for raw in proc.stdout:
                with lock:
                    out.append(raw.decode("utf-8", "replace").rstrip("\n"))
        t = threading.Thread(target=pump, daemon=True)
        t.start()
        pat = re.compile(rf"^aegis\[(\d+)\]: serving .*, config ({HEX64}) \(generation (\d+)\)")
        line_hash, hz_hash, until = None, None, time.time() + timeout
        while time.time() < until and (line_hash is None or hz_hash is None):
            if proc.poll() is not None:
                time.sleep(0.2)
                with lock:
                    tail = " | ".join(out[-5:])
                raise Fail(f"subject exited {proc.returncode} during boot: {tail[-300:]}")
            with lock:
                for l in out:
                    m = pat.match(l)
                    if m:
                        if int(m[1]) != proc.pid:
                            raise Fail(f"boot line names pid {m[1]}, the process started is {proc.pid}")
                        line_hash = m[2]
            if hz_hash is None:
                try:
                    st, body = healthz(port)
                    if st == 200:
                        hm = re.findall(rf'"config_hash":"({HEX64})"', body)
                        if len(hm) != 1:
                            raise Fail(f"/healthz has {len(hm)} config_hash members: {body[:200]!r}")
                        hz_hash = hm[0]
                except OSError:
                    pass
            time.sleep(0.2)
        if line_hash is None or hz_hash is None:
            raise Fail(f"no {'boot line' if line_hash is None else '/healthz 200'} within {timeout} s")
        return line_hash, hz_hash
    finally:
        if proc is not None and proc.poll() is None:
            proc.send_signal(signal.SIGTERM)
            try:
                proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait(timeout=10)
        shutil.rmtree(d, ignore_errors=True)


def record(subject, binary, cfg, timeout):
    """Returns the evidence line; raises Fail on any disagreement."""
    if not re.fullmatch(r"[A-Za-z0-9._-]+", subject):
        raise Fail(f"subject name {subject!r} not [A-Za-z0-9._-]+")
    if not (os.path.isfile(binary) and os.access(binary, os.X_OK)):
        raise Fail(f"binary {binary} not an executable file")
    art = sha256_file(binary)
    port = admin_port(cfg)
    h1 = check_config(binary, cfg)
    h3, h4 = boot(binary, cfg, port, timeout)
    if not (h1 == h3 == h4):
        raise Fail(f"effective-config hashes disagree: check-config {h1[:16]}, boot line {h3[:16]}, "
                   f"/healthz {h4[:16]}")
    if sha256_file(binary) != art:
        raise Fail("binary changed while it was being judged")
    return (f"CONFORMANCE-BOOT: {subject} artifact {art} config {h1} "
            f"(check-config, boot line of the pid started, /healthz agree; "
            f"config {os.path.relpath(cfg, ROOT)})")


def main_run(a):
    try:
        cfg = a.config if a.config else golden_config(a.subject)
        line = record(a.subject, os.path.abspath(a.binary), os.path.abspath(cfg), a.timeout)
    except (Fail, OSError, ValueError, subprocess.TimeoutExpired) as e:
        print(f"BOOT-PIN: FAIL ({a.subject}: {e})")
        return 1
    print(line)
    print(f"BOOT-PIN: PASS ({a.subject})")
    return 0


MUTANTS = ["healthz-hash", "bootline-hash", "bootline-pid", "check-hash", "check-two-lines", "check-exit",
           "exit-at-boot"]


def self_test():
    if not os.access(FAKE, os.X_OK):
        print(f"BOOT-PIN SELF-TEST: FAIL ({FAKE} missing or not executable)")
        return 1
    d = tempfile.mkdtemp(prefix="aegis-boot-pin-st-")
    bad = []
    try:
        cfg = os.path.join(d, "golden.f8.json")
        # a free port for the stand-in's admin endpoint
        import socket
        s = socket.socket()
        s.bind(("127.0.0.1", 0))
        port = s.getsockname()[1]
        s.close()
        with open(cfg, "w") as f:
            json.dump({"v": 1, "listeners": [{"name": "pub", "bind": "127.0.0.1:1", "profile": "P-PUBLIC-WEB"}],
                       "admin": {"bind": f"127.0.0.1:{port}"},
                       "vhosts": [{"host": "aegis.test", "routes": [{"id": 1, "path": "/", "to": {"upstream": "x"}}]}]},
                      f)
        for mut in [None] + MUTANTS:
            wrapper = os.path.join(d, f"aegis-{mut or 'honest'}")
            with open(wrapper, "w") as f:
                f.write(f"#!/bin/sh\nAEGIS_FAKE_MUTANT={mut or ''} exec {sys.executable} -I {FAKE} \"$@\"\n")
            os.chmod(wrapper, 0o755)
            try:
                line = record("st-subject", wrapper, cfg, 15)
                got = line
            except (Fail, OSError, subprocess.TimeoutExpired) as e:
                got = None
                why = str(e)
            if mut is None:
                ok = got is not None and re.match(rf"^CONFORMANCE-BOOT: st-subject artifact {HEX64} config {HEX64} ",
                                                  got) is not None
                print(f"  {'ok  ' if ok else 'BAD '} honest stand-in: {got[:90] if got else 'FAIL ' + why}")
            else:
                ok = got is None
                print(f"  {'ok  ' if ok else 'BAD '} mutant {mut}: {'refused: ' + why[:90] if got is None else 'ACCEPTED'}")
            if not ok:
                bad.append(mut or "honest")
    finally:
        shutil.rmtree(d, ignore_errors=True)
    if bad:
        print(f"BOOT-PIN SELF-TEST: FAIL ({', '.join(bad)})")
        return 1
    print(f"BOOT-PIN SELF-TEST: PASS (honest stand-in recorded; {len(MUTANTS)}/{len(MUTANTS)} disagreeing stand-ins "
          f"refused)")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="conformance/boot-pin")
    ap.add_argument("--subject")
    ap.add_argument("--binary")
    ap.add_argument("--config")
    ap.add_argument("--timeout", type=float, default=30.0)
    ap.add_argument("--self-test", action="store_true")
    a = ap.parse_args()
    if a.self_test:
        return self_test()
    if not (a.subject and a.binary):
        print("usage: conformance/boot-pin --subject NAME --binary PATH [--config FILE] | --self-test")
        return 2
    return main_run(a)


if __name__ == "__main__":
    sys.exit(main())
