#!/usr/bin/env -S python3 -I
"""select-drt: differential test of the Lean Select(model) against the hrr-verdicts oracle's selection model.

  oracles/select-drt/run [--cases N] [--seed S] [--file tls/verdicts.toml]
  oracles/select-drt/run --self-test [--cases N] [--seed S]

Lean side : `select-drt` (lake exe of this directory) = AegisIR.Select.select from spec/AegisIR/Select.lean.
Oracle side: `fn model` + its types (Outcome, Profile, ProbeCase) taken VERBATIM from
             oracles/hrr-verdicts/src/main.rs at run time (not a copy kept here), wrapped in a stdin/stdout harness
             and compiled with plain rustc (std only). Profiles come from tls/verdicts.toml (F12).
Last line `SELECT-DRT: PASS (...)` iff 0 divergence on N cases per profile (all eight F8 profiles), the Lean profile
table equals F12, and every profile hit server_hello, hrr and alert at least once. Exit 0 only on PASS.
Builds go through ci/heavy.sh; build output stays in oracles/select-drt/target and .lake (both git-ignored).
"""
import hashlib, json, os, random, re, subprocess, sys, tomllib

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.abspath(os.path.join(HERE, "..", ".."))
HEAVY = os.path.join(REPO, "ci", "heavy.sh")
MAIN_RS = os.path.join(REPO, "oracles", "hrr-verdicts", "src", "main.rs")
F8 = os.path.join(REPO, "interfaces", "F8-config.schema.json")
TARGET = os.path.join(HERE, "target")
LEAN_BIN = os.path.join(HERE, ".lake", "build", "bin", "select-drt")
LEAN_PATH = os.path.expanduser("~/.elan/toolchains/leanprover--lean4---v4.35.0/bin")
# Codepoints offered by generated ClientHellos: every F12 group plus classical / unknown / GREASE values no profile
# supports (P-521, X448, ffdhe2048, ML-KEM-512, GREASE 0x0A0A, unassigned 0x11EE).
EXTRA = [0x0019, 0x001E, 0x0100, 0x0200, 0x0A0A, 0x11EE]


def die(msg):
    print(f"SELECT-DRT: FAIL ({msg})")
    sys.exit(1)


def sh(cmd, **kw):
    return subprocess.run(cmd, **kw)


# ------------------------------------------------------------------------------------------------ oracle model
def rust_item(src, start_pat, name):
    """Text of one Rust item: from its attributes/doc comments through the matching closing brace."""
    m = re.search(start_pat, src, flags=re.M)
    if not m:
        die(f"cannot find {name} in {MAIN_RS}")
    i = m.start()
    # include immediately preceding attribute / doc-comment lines
    lines_before = src[:i].split("\n")
    pre = []
    for ln in reversed(lines_before[:-1]):
        if ln.strip().startswith(("#[", "///")):
            pre.insert(0, ln)
        else:
            break
    j = src.index("{", m.end() - 1)
    depth = 0
    for k in range(j, len(src)):
        if src[k] == "{":
            depth += 1
        elif src[k] == "}":
            depth -= 1
            if depth == 0:
                return "\n".join(pre + [src[i:k + 1]])
    die(f"unbalanced braces in {name}")


def oracle_model_source():
    src = open(MAIN_RS).read()
    items = [
        rust_item(src, r"^enum Outcome\s*\{", "enum Outcome"),
        rust_item(src, r"^struct Profile\s*\{", "struct Profile"),
        rust_item(src, r"^struct ProbeCase\s*\{", "struct ProbeCase"),
        rust_item(src, r"^fn model\(p: &Profile, c: &ProbeCase\) -> Outcome\s*\{", "fn model"),
    ]
    return "\n\n".join(items)


HARNESS = r'''
// GENERATED by oracles/select-drt/run: the items above are copied verbatim from oracles/hrr-verdicts/src/main.rs.
use std::collections::BTreeMap;
use std::io::{BufRead, Write};

fn hexlist(s: &str) -> Vec<u16> {
    if s == "-" { return Vec::new(); }
    s.split(',').map(|x| u16::from_str_radix(x, 16).unwrap_or(0xFFFF)).collect()
}

fn main() {
    let stdin = std::io::stdin();
    let out = std::io::stdout();
    let mut out = std::io::BufWriter::new(out.lock());
    let mut profiles: BTreeMap<String, Profile> = BTreeMap::new();
    for line in stdin.lock().lines() {
        let line = match line { Ok(l) => l, Err(_) => break };
        let w: Vec<&str> = line.split_whitespace().collect();
        match w.as_slice() {
            ["PROFILE", name, selector, kx] => {
                profiles.insert(name.to_string(), Profile {
                    status: String::new(), selector: selector.to_string(), kx: hexlist(kx),
                    sigalgs: Vec::new(), versions: Vec::new(), early_data: false,
                });
            }
            [name, gs, ss] => {
                let p = match profiles.get(*name) { Some(p) => p, None => { eprintln!("unknown profile {name}"); std::process::exit(2) } };
                let c = ProbeCase { groups: hexlist(gs), shares: hexlist(ss), sigalgs: Vec::new() };
                let s = match model(p, &c) {
                    Outcome::Sh(g) => format!("sh {g:04x}"),
                    Outcome::Hrr(g) => format!("hrr {g:04x}"),
                    Outcome::Alert(a) => format!("alert {a}"),
                    Outcome::Other(s) => format!("other {s}"),
                };
                let _ = writeln!(out, "{s}");
            }
            _ => { eprintln!("bad line {line}"); std::process::exit(2) }
        }
    }
}
'''


def build_oracle(model_src, tag):
    os.makedirs(TARGET, exist_ok=True)
    rs = os.path.join(TARGET, f"oracle-model-{tag}.rs")
    exe = os.path.join(TARGET, f"oracle-model-{tag}")
    open(rs, "w").write("#![allow(dead_code)]\n" + model_src + "\n" + HARNESS)
    r = sh([HEAVY, "rustc", "--edition", "2024", "-O", "-o", exe, rs], cwd=REPO, capture_output=True, text=True)
    if r.returncode != 0:
        print(r.stderr[-3000:])
        die(f"oracle harness ({tag}) did not compile")
    return exe


def build_lean():
    env = dict(os.environ, PATH=LEAN_PATH + ":" + os.environ.get("PATH", ""))
    r = sh([HEAVY, "lake", "build", "select-drt"], cwd=HERE, env=env, capture_output=True, text=True)
    if r.returncode != 0 or not os.path.exists(LEAN_BIN):
        print((r.stdout + r.stderr)[-3000:])
        die("lake build select-drt failed")


# ------------------------------------------------------------------------------------------------ profiles
def f12_profiles(path):
    doc = tomllib.load(open(path, "rb"))
    groups = doc["codepoints"]["groups"]
    return groups, {n: (p["selector"], [groups[g] for g in p["kx_groups"]]) for n, p in doc["profiles"].items()}


def lean_profiles(mutant_file=None):
    r = sh([LEAN_BIN, "profiles"], capture_output=True, text=True)
    if r.returncode != 0:
        die("select-drt profiles failed")
    rows = []
    for ln in r.stdout.splitlines():
        name, row, sel, kx = ln.split()
        rows.append((name, row, sel, [int(x, 16) for x in kx.split(",")]))
    return rows


def table_check(rows, f12):
    """Lean table vs F12 rows and the F8 profile enum. Returns list of problems."""
    probs = []
    f8 = None
    for k, v in walk(json.load(open(F8))):
        if k == "profile" and isinstance(v, dict) and "enum" in v:
            f8 = v["enum"]
    if f8 is None:
        probs.append("F8 profile enum not found")
    elif [r[0] for r in rows] != f8:
        probs.append(f"Lean profiles {[r[0] for r in rows]} != F8 enum {f8}")
    used = set()
    for name, row, sel, kx in rows:
        if row not in f12:
            probs.append(f"{name}: F12 row {row} not in verdicts.toml")
            continue
        used.add(row)
        if (sel, kx) != f12[row]:
            probs.append(f"{name}: Lean ({sel}, {[hex(g) for g in kx]}) != F12 {row} "
                         f"({f12[row][0]}, {[hex(g) for g in f12[row][1]]})")
    for row in f12:
        if row not in used:
            probs.append(f"F12 row {row} not modelled in Lean")
    return probs


def walk(o):
    if isinstance(o, dict):
        for k, v in o.items():
            yield k, v
            yield from walk(v)
    elif isinstance(o, list):
        for v in o:
            yield from walk(v)


# ------------------------------------------------------------------------------------------------ cases
def gen_cases(rows, universe, n, seed):
    rnd = random.Random(seed)
    lines = []
    for name, _, _, kx in rows:
        for _ in range(n):
            k = rnd.randint(0, 6)
            # half the hellos are biased toward the profile's own groups so multi-group profiles see their groups in
            # every relative order (the order mutant needs two profile groups in non-server order)
            pool = universe if rnd.random() < 0.5 else sorted(set(kx) | set(rnd.sample(universe, 3)))
            gs = rnd.sample(pool, min(k, len(pool)))
            ss = [g for g in gs if rnd.random() < 0.5]
            rnd.shuffle(ss)
            f = lambda l: ",".join(f"{g:04x}" for g in l) if l else "-"
            lines.append(f"{name} {f(gs)} {f(ss)}")
    return lines


def run_lean(lines, mutant=None):
    args = [LEAN_BIN] + (["--mutate", mutant] if mutant else [])
    r = sh(args, input="\n".join(lines) + "\n", capture_output=True, text=True)
    if r.returncode != 0:
        die(f"select-drt exited {r.returncode}: {r.stderr[-500:]}")
    return r.stdout.splitlines()


def run_oracle(exe, rows_for_oracle, lines):
    hdr = [f"PROFILE {name} {sel} {','.join(f'{g:04x}' for g in kx)}" for name, sel, kx in rows_for_oracle]
    r = sh([exe], input="\n".join(hdr + lines) + "\n", capture_output=True, text=True)
    if r.returncode != 0:
        die(f"oracle model exited {r.returncode}: {r.stderr[-500:]}")
    return r.stdout.splitlines()


def compare(lines, a, b):
    if len(a) != len(lines) or len(b) != len(lines):
        return [("<length>", f"lean {len(a)} oracle {len(b)} cases {len(lines)}")], {}
    div, kinds = [], {}
    for ln, x, y in zip(lines, a, b):
        p = ln.split()[0]
        kinds.setdefault(p, {"sh": 0, "hrr": 0, "alert": 0, "other": 0})[y.split()[0]] += 1
        if x != y:
            div.append((ln, f"lean={x} oracle={y}"))
    return div, kinds


def oracle_rows(rows, f12):
    """Oracle profiles: each F8 profile gets its F12 row's selector + kx_groups straight from verdicts.toml."""
    return [(name, f12[row][0], f12[row][1]) for name, row, _, _ in rows if row in f12]


def drt(exe, rows, f12, universe, n, seed, mutant=None):
    lines = gen_cases(rows, universe, n, seed)
    div, kinds = compare(lines, run_lean(lines, mutant), run_oracle(exe, oracle_rows(rows, f12), lines))
    return lines, div, kinds


def main():
    a = sys.argv[1:]
    opt = lambda f, d: a[a.index(f) + 1] if f in a else d
    selftest = "--self-test" in a
    n = int(opt("--cases", "10000" if selftest else "100000"))
    seed = int(opt("--seed", "1"))
    vf = opt("--file", os.path.join(REPO, "tls", "verdicts.toml"))
    if not os.path.isabs(vf):
        vf = os.path.join(os.getcwd(), vf)

    build_lean()
    msrc = oracle_model_source()
    print(f"oracle model: {MAIN_RS} (fn model + types, sha256 {hashlib.sha256(msrc.encode()).hexdigest()[:16]})")
    print(f"verdict file: {vf} (sha256 {hashlib.sha256(open(vf, 'rb').read()).hexdigest()[:16]})")
    exe = build_oracle(msrc, "ref")
    groups, f12 = f12_profiles(vf)
    universe = sorted(set(groups.values()) | set(EXTRA))
    rows = lean_profiles()

    if not selftest:
        probs = table_check(rows, f12)
        for p in probs:
            print(f"TABLE {p}")
        lines, div, kinds = drt(exe, rows, f12, universe, n, seed)
        for ln, d in div[:20]:
            print(f"DIVERGE {ln}  {d}")
        vac = []
        for name, *_ in rows:
            k = kinds.get(name, {})
            print(f"PROFILE {name:17s} cases={n} sh={k.get('sh', 0)} hrr={k.get('hrr', 0)} alert={k.get('alert', 0)}")
            if not all(k.get(x, 0) > 0 for x in ("sh", "hrr", "alert")):
                vac.append(name)
        if probs or div or vac:
            die(f"{len(div)} divergences, {len(probs)} table problems, outcome kinds missing for {vac} "
                f"({len(lines)} cases, seed {seed})")
        print(f"SELECT-DRT: PASS ({len(rows)} profiles x {n} cases = {len(lines)}, seed {seed}, 0 divergence; "
              f"Lean table == F12; rung R4 model + R2 correspondence)")
        return

    # ---------------------------------------------------------------- self-test
    results, bad = [], []
    probs = table_check(rows, f12)
    _, div, _ = drt(exe, rows, f12, universe, n, seed)
    ok = not probs and not div
    results.append(f"baseline: {len(div)} divergences, {len(probs)} table problems")
    if not ok:
        bad.append("baseline not clean")
    # Lean-side mutants (in select-drt Main.lean; the spec module is untouched). Each must diverge within n cases.
    for m in ["order:P-PUBLIC-WEB", "order:P-BSI-ALT", "order:FIPS-FLOOR", "order:FIPS-CMVP", "share-ignored"]:
        _, div, _ = drt(exe, rows, f12, universe, n, seed, m)
        results.append(f"lean mutant {m}: {len(div)} divergences" + (f" (first: {div[0][0]} {div[0][1]})" if div else ""))
        if not div:
            bad.append(m)
    # Oracle-side mutant: a mutated copy of the oracle's own fn model with the selector branches swapped.
    mut = msrc.replace('p.selector == "server-order"', 'p.selector != "server-order"', 1)
    if mut == msrc:
        bad.append("oracle-copy mutant could not be applied")
    else:
        mexe = build_oracle(mut, "mut-branches-swapped")
        _, div, _ = drt(mexe, rows, f12, universe, n, seed)
        results.append(f"oracle-copy mutant branches-swapped: {len(div)} divergences")
        if not div:
            bad.append("oracle-copy branches-swapped")
    # Profile-table mutant: a verdict file whose P-UNIVERSAL list differs from the Lean table.
    f12m = dict(f12)
    f12m["P-UNIVERSAL"] = ("client-order", [0x11EC])
    pm = table_check(rows, f12m)
    _, div, _ = drt(exe, rows, f12m, universe, n, seed)
    results.append(f"verdict-file mutant P-UNIVERSAL=[0x11EC]: {len(pm)} table problems, {len(div)} divergences")
    if not pm or not div:
        bad.append("verdict-file P-UNIVERSAL")
    # Equivalent mutant: reversing a group list is invisible under client-order (README known limit of
    # hrr-verdicts); it must stay at 0, otherwise one of the two models is not client-order.
    _, div, _ = drt(exe, rows, f12, universe, n, seed, "kx-reversed:P-PUBLIC-WEB")
    results.append(f"equivalent mutant kx-reversed:P-PUBLIC-WEB: {len(div)} divergences (expected 0)")
    if div:
        bad.append("kx-reversed diverged (selection is not client-order)")
    for r in results:
        print(r)
    if bad:
        print(f"SELECT-DRT SELF-TEST: FAIL (not caught / not clean: {bad})")
        sys.exit(1)
    print(f"SELECT-DRT SELF-TEST: PASS (7/7 mutants caught within {n} cases per profile; baseline clean; "
          f"equivalent mutant 0 divergence)")


if __name__ == "__main__":
    main()
