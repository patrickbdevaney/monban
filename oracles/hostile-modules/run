#!/usr/bin/env bash
# Monban oracle: hostile-modules (Phase-5 gates p2-hostile-worker, p2-hostile-host; unit P5-oracle-hostile-001).
# Contract: oracles/README.md; subject contracts, cases and expected outcomes: oracles/hostile-modules/README.md.
# Last line: HOSTILE-MODULES: PASS|FAIL (...)  /  HOSTILE-MODULES SELF-TEST: PASS|FAIL (...)
#   ./run                                   both levels against the reference (hostref worker + ref_host.py)
#   ./run --self-test                       both levels: reference green, every reference mutant red
#   ./run --level worker --subject <monban-p2>
#   ./run --self-test --level worker --subject <monban-p2> --mutant-subject <monban-p2 mutants build>
#   ./run --level host --subject <monban> --worker <monban-p2>
#   ./run --self-test --level host --subject <monban> --worker <monban-p2> --mutant-subject <monban p2-mutants>
#         --mutant-worker <monban-p2 mutants>
#   --only id,id (debugging; never PASS)  -v (list every passing cell)  --keep-build (keep rust/target)
# The reference worker is built under ci/heavy.sh into rust/target and deleted at exit (laptop disk rule).
set -u
HERE=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$HERE/../.." && pwd)
cd "$REPO" || exit 1
keep=0; args=()
for x in "$@"; do if [ "$x" = "--keep-build" ]; then keep=1; else args+=("$x"); fi; done
cleanup() { [ "$keep" = 1 ] || rm -rf "$HERE/rust/target"; rm -rf "$HERE/__pycache__"; }
trap cleanup EXIT
python3 -I "$HERE/hostile.py" "${args[@]}"
