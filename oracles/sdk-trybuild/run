#!/usr/bin/env bash
# oracles/sdk-trybuild/run [--self-test] [--bless]
# Gate sdk-trybuild (P4-oracle-trybuild-001). Builds the real sdk/monban-sdk (main workspace, --locked), runs
# `cargo test --doc -p monban-sdk`, compiles the corpus with the pinned rustc + clippy-driver, runs the host-loop
# harness, and compares with expected.txt (frozen) and snapshots.txt. Run under ci/heavy.sh or ci/remote.sh.
# Last line: SDK-TRYBUILD: PASS|FAIL (...) or SDK-TRYBUILD SELF-TEST: PASS|FAIL (...). Exit 0 only on PASS.
# target/ is deleted afterwards unless KEEP_TARGET=1.
set -u
here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../.." && pwd)
mode=check
case "${1:-}" in
  --self-test) mode=self-test;;
  --bless) mode=bless;;
  "") ;;
  *) echo "usage: $0 [--self-test|--bless]"; exit 2;;
esac
export SDK_TRYBUILD_TARGET="${SDK_TRYBUILD_TARGET:-$here/target}"
cd "$repo"
"$repo/ci/heavy.sh" python3 -I "$here/oracle.py" "$mode"
rc=$?
[ "${KEEP_TARGET:-0}" = 1 ] || rm -rf "$SDK_TRYBUILD_TARGET"
exit $rc
