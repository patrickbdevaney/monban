+//! VERIFICATION SKETCH ONLY (P5-wasm-002, not committed; cordon.rs belongs to P5-iso-003): the smallest cordon that
+//! drives `aegis_wasm::abi::Session::serve_all`, used to run the hostile-modules cordon cells and the
+//! handle-not-cleared mutant against the F14 worker. P5-iso-003 owns the real cordon (registry, crash budget,
+//! idle reaping, MPK cell).
+
+use std::path::Path;
+use std::process::ExitCode;
+
+use aegis_iso::sandbox::{self, Profile, SandboxError};
+use aegis_iso::zygote;
+use aegis_wasm::abi::{F14Worker, frame};
+use aegis_wasm::engine::{FUEL_MAX, WALL_MS_MAX, cwasm};
+use aegis_wasm::{EpochTicker, P2Engine, P2Limits};
+
+fn fail(code: u8, msg: &str) -> ExitCode {
+    eprintln!("aegis-p2: {msg}");
+    ExitCode::from(code)
+}
+
+/// `aegis-p2 cordon --module <c.cwasm> --sha256 <hex>` (sketch).
+pub fn run(args: &[String]) -> ExitCode {
+    let a = match crate::zygote::parse(args) {
+        Ok(a) => a,
+        Err(e) => return fail(64, &format!("cordon: {e}")),
+    };
+    let (Some(module), Some(hex)) = (a.module.as_deref(), a.sha256.as_deref()) else {
+        return fail(64, "cordon: --module and --sha256 are required");
+    };
+    let Some(digest) = crate::zygote::parse_hex(hex) else { return fail(64, "cordon: bad --sha256") };
+    let settings = match crate::zygote::settings(a.mpk, crate::zygote::mutant_memory_mib(a.memory_mib), a.pool_slots) {
+        Ok(s) => s,
+        Err(e) => return fail(78, &format!("cordon: {e}")),
+    };
+    let Ok(engine) = P2Engine::new(settings) else { return fail(78, "cordon: engine") };
+    let m = match cwasm::load(&engine, Path::new(module), &digest) {
+        Ok(m) => m,
+        Err(e) => return fail(78, &format!("cordon: {e}")),
+    };
+    let mem = u32::try_from(settings.pooling_max_memory_size() >> 20).unwrap_or(16);
+    let Ok(ceiling) = P2Limits::new(FUEL_MAX, WALL_MS_MAX, mem) else { return fail(78, "cordon: ceiling") };
+    let worker = match F14Worker::new(&engine, &m, ceiling) {
+        Ok(w) => w,
+        Err(e) => return fail(78, &format!("cordon: {e}")),
+    };
+    drop(m);
+    let Ok(listener) = zygote::adopt_listener() else { return fail(78, "cordon: fd 3") };
+    if let Err(e) = sandbox::install(&Profile::cordon(Vec::new())) {
+        let code = if matches!(e, SandboxError::LandlockAbiTooOld(_)) { 78 } else { 70 };
+        return fail(code, &format!("cordon: {e}"));
+    }
+    let _ticker = match EpochTicker::start(&engine) {
+        Ok(t) => t,
+        Err(e) => return fail(70, &format!("cordon: epoch ticker: {e}")),
+    };
+    let listener = std::os::unix::net::UnixListener::from(listener);
+    loop {
+        let conn = match listener.accept() {
+            Ok((c, _)) => c,
+            Err(e) => return fail(70, &format!("cordon: accept: {e}")),
+        };
+        let mut s = worker.session(conn);
+        if s.send(&frame::ready(&digest)) {
+            let _ = s.serve_all();
+        }
+    }
+}
