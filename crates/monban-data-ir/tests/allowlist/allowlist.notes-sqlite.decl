aegis-allowlist-decl v1
adapter notes-sqlite
family sqlite
# Fixture declaration (P4-datair-001), shaped like apps/notes. Fields: 0 tenant, 1 id, 2 title, 3 body.
# Regenerate the lock with: target/release/datair-subject lock <this file> > allowlist.notes-sqlite.lock
schema notes tenant=0 key=1 cols=0,1,2,3 permitted=1,2,3

op notes select eq(1) w=- r=1,2,3
op notes select pfx(2) w=- r=1,2
op notes select and(range(1),not(in(2))) w=- r=1
op notes insert tt w=1,2,3 r=1
op notes update eq(1) w=3,2 r=-
op notes upsert tt w=1,2,3 r=1,2,3
op notes delete eq(1) w=- r=-
