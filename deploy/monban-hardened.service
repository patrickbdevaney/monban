# Monban reverse proxy (mode R), hardened systemd unit. Unit P2-proxy-001; Phase-2 gate "systemd <= 2".
# Install: /etc/systemd/system/monban.service; config /etc/monban/monban.json; TLS chain/key as credentials.
# Check: systemd-analyze security --offline=yes deploy/monban-hardened.service
[Unit]
Description=Monban reverse proxy (mode R)
Documentation=file:///usr/share/doc/monban/README.md
After=network-online.target
Wants=network-online.target

[Service]
# READY=1 after the listeners accept; SIGHUP = config reload (last-known-good on error), SIGUSR2 = zero-downtime
# upgrade (the new process sends MAINPID=, hence NotifyAccess=all).
Type=notify
NotifyAccess=all
ExecStartPre=/usr/bin/monban check-config /etc/monban/monban.json
ExecStart=/usr/bin/monban --config /etc/monban/monban.json --cert %d/tls.crt --key %d/tls.key
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=2
# 78 (EX_CONFIG) = refused to boot on a bad config: do not restart-loop on it.
RestartPreventExitStatus=78

# Keys: read once at start from root-owned files, exposed only to this unit under $CREDENTIALS_DIRECTORY.
LoadCredential=tls.crt:/etc/monban/tls/fullchain.pem
LoadCredential=tls.key:/etc/monban/tls/privkey.pem

# Identity and state
DynamicUser=yes
StateDirectory=monban
StateDirectoryMode=0700
RuntimeDirectory=monban
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
ConfigurationDirectory=monban
UMask=0077

# Privileges: bind :443 and nothing else.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
SecureBits=noroot-locked

# Filesystem
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
PrivateUsers=no
KeyringMode=private
DevicePolicy=closed

# Network: IP + unix sockets (upstream / admin UDS, sd-notify); no netlink, no packet sockets.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
IPAccounting=yes

# System calls
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot @raw-io @module @obsolete @cpu-emulation @debug @clock
# PLAN-7 D-P7.3 / FRONT: io_uring (in @aio, so in @system-service) is denied unless deploy/uring.conf is installed.
SystemCallFilter=~io_uring_setup io_uring_enter io_uring_register
SystemCallErrorNumber=EPERM

# Resources (provisional; ARCHITECTURE §6)
LimitNOFILE=65536
TasksMax=256
MemoryMax=1G

[Install]
WantedBy=multi-user.target
