{
  "_doc": "Mutants for ci/wasmtime-config.py --self-test. Each copies ci/fixtures/wasmtime-config/clean, applies ops (json: merge keys into a JSON file; replace: substring replace, count default 1; write; delete), optionally applies expect_ops to a copy of supply-chain/wasmtime-config.toml, and must FAIL with every rule in `red` and none in `must_not`. GHSA shapes are the advisories' own conditions as quoted in supply-chain/wasmtime-config.toml.",
  "mutants": [
    {"name": "ghsa-6wgr-shape",
     "why": "GHSA-6wgr-89rj-399p: pooling + memory_guard_size 0 + memory_reservation < 4GiB + max_memory_size == memory_reservation",
     "ops": [
       {"op": "json", "file": "config.json", "set": {"memory_guard_size": 0, "memory_reservation": 16777216, "pooling_max_memory_size": 16777216}},
       {"op": "json", "file": "config-mpk.json", "set": {"memory_guard_size": 0, "memory_reservation": 16777216, "pooling_max_memory_size": 16777216}}],
     "red": ["ghsa-6wgr-shape", "mpk:ghsa-6wgr-shape", "frozen:memory_guard_size"]},
    {"name": "ghsa-394w-shape",
     "why": "GHSA-394w-hwhg-8vgm: reserve less memory (< 4GiB) and remove all guard pages; max_memory_size below the reservation so the 6wgr shape does not apply",
     "ops": [
       {"op": "json", "file": "config.json", "set": {"memory_guard_size": 0, "memory_reservation": 1073741824}},
       {"op": "json", "file": "config-mpk.json", "set": {"memory_guard_size": 0, "memory_reservation": 1073741824}}],
     "red": ["ghsa-394w-shape", "mpk:ghsa-394w-shape"], "must_not": ["ghsa-6wgr-shape"]},
    {"name": "guard-shrunk",
     "ops": [{"op": "json", "file": "config.json", "set": {"memory_guard_size": 65536}}],
     "red": ["guard-shrunk", "frozen:memory_guard_size", "mpk-changed:memory_guard_size"], "must_not": ["ghsa-394w-shape"]},
    {"name": "reservation-below-4gib",
     "ops": [
       {"op": "json", "file": "config.json", "set": {"memory_reservation": 2147483648}},
       {"op": "json", "file": "config-mpk.json", "set": {"memory_reservation": 2147483648}}],
     "red": ["reservation-below-4gib", "mpk:reservation-below-4gib"], "must_not": ["ghsa-394w-shape", "mpk-changed:memory_reservation"]},
    {"name": "mpk-with-shrunk-guard",
     "why": "MPK density bought by dropping the guard (the forbidden trade, ARCHITECTURE 3.6)",
     "ops": [{"op": "json", "file": "config-mpk.json", "set": {"memory_guard_size": 0}}],
     "red": ["mpk:guard-shrunk", "mpk-changed:memory_guard_size", "mpk:frozen:memory_guard_size"], "must_not": ["guard-shrunk"]},
    {"name": "mpk-with-shrunk-reservation",
     "why": "MPK with a density-tuned 128 MiB reservation",
     "ops": [{"op": "json", "file": "config-mpk.json", "set": {"memory_reservation": 134217728}}],
     "red": ["mpk:reservation-below-4gib", "mpk-changed:memory_reservation"], "must_not": ["reservation-below-4gib"]},
    {"name": "mpk-auto",
     "ops": [{"op": "json", "file": "config-mpk.json", "set": {"memory_protection_keys": "auto"}}],
     "red": ["mpk:mpk-value"]},
    {"name": "memory64-true",
     "ops": [{"op": "json", "file": "config.json", "set": {"wasm_memory64": true}}],
     "red": ["memory64-on"]},
    {"name": "gc-true",
     "ops": [{"op": "json", "file": "config.json", "set": {"wasm_gc": true}}],
     "red": ["gc-on"]},
    {"name": "component-model-true",
     "ops": [{"op": "json", "file": "config.json", "set": {"wasm_component_model": true}}],
     "red": ["component-model-on"]},
    {"name": "epoch-false",
     "ops": [{"op": "json", "file": "config.json", "set": {"epoch_interruption": false}}],
     "red": ["epoch-off"]},
    {"name": "fuel-false",
     "ops": [{"op": "json", "file": "config.json", "set": {"consume_fuel": false}}],
     "red": ["fuel-off"]},
    {"name": "schema-extra-key",
     "ops": [{"op": "json", "file": "config.json", "set": {"memory_init_cow": true}}],
     "red": ["schema:extra:memory_init_cow"]},
    {"name": "threads-feature",
     "ops": [{"op": "replace", "file": "tree.txt", "old": "├── wasmtime feature \"cranelift\"\n",
              "new": "├── wasmtime feature \"threads\"\n│   └── wasmtime v50.0.1 (*)\n├── wasmtime feature \"cranelift\"\n"}],
     "red": ["feature-forbidden:threads"]},
    {"name": "component-model-async-feature",
     "ops": [{"op": "replace", "file": "tree.txt", "old": "├── wasmtime feature \"cranelift\"\n",
              "new": "├── wasmtime feature \"component-model-async\"\n│   ├── wasmtime feature \"async\"\n│   │   └── wasmtime v50.0.1 (*)\n│   └── wasmtime feature \"component-model\"\n│       └── wasmtime v50.0.1 (*)\n├── wasmtime feature \"cranelift\"\n"}],
     "red": ["feature-forbidden:component-model-async", "feature-forbidden:async", "feature-forbidden:component-model"]},
    {"name": "mpk-feature-missing",
     "ops": [
       {"op": "replace", "file": "tree.txt", "old": "wasmtime feature \"memory-protection-keys\"", "new": "wasmtime feature \"pooling-allocator\""},
       {"op": "replace", "file": "tree.txt", "old": "wasmtime feature \"call-hook\"", "new": "wasmtime feature \"runtime\""}],
     "red": ["feature-missing:memory-protection-keys", "feature-missing:call-hook"]},
    {"name": "wasmtime-wasi-crate",
     "ops": [{"op": "replace", "file": "tree.txt", "old": "├── wasmtime feature \"cranelift\"\n",
              "new": "├── wasmtime-wasi feature \"default\"\n│   └── wasmtime-wasi v50.0.1\n├── wasmtime feature \"cranelift\"\n"}],
     "red": ["crate-forbidden:wasmtime-wasi"]},
    {"name": "wasmtime-wasi-http-crate",
     "ops": [
       {"op": "replace", "file": "Cargo.lock", "old": "[[package]]\nname = \"wasmtime\"\n",
        "new": "[[package]]\nname = \"wasmtime-wasi-http\"\nversion = \"50.0.1\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\n\n[[package]]\nname = \"wasmtime\"\n"},
       {"op": "replace", "file": "tree.txt", "old": "├── wasmtime feature \"cranelift\"\n",
        "new": "├── wasmtime-wasi-http feature \"default\"\n│   └── wasmtime-wasi-http v50.0.1\n├── wasmtime feature \"cranelift\"\n"}],
     "red": ["crate-forbidden:wasmtime-wasi-http"]},
    {"name": "wasmtime-version-lock",
     "ops": [{"op": "replace", "file": "Cargo.lock", "old": "name = \"wasmtime\"\nversion = \"50.0.1\"", "new": "name = \"wasmtime\"\nversion = \"49.0.4\""}],
     "red": ["pin:lock"]},
    {"name": "wasmtime-version-tree",
     "ops": [{"op": "replace", "file": "tree.txt", "old": "wasmtime v50.0.1", "new": "wasmtime v50.0.0", "count": 1000}],
     "red": ["pin:tree"]},
    {"name": "second-deserialize-site",
     "ops": [{"op": "write", "file": "src/crates/aegis-p2/src/load.rs",
              "text": "use wasmtime::{Engine, Module};\npub fn load(engine: &Engine, bytes: &[u8]) -> Option<Module> {\n    unsafe { Module::deserialize(engine, bytes) }.ok()\n}\n"}],
     "red": ["deserialize-count", "deserialize-outside-aegis-wasm"]},
    {"name": "second-deserialize-site-aliased",
     "ops": [{"op": "write", "file": "src/crates/aegis-wasm/src/store/extra.rs",
              "text": "use wasmtime::{Engine, Module as M};\npub fn load(engine: &Engine, bytes: &[u8]) -> Option<M> {\n    unsafe { M :: deserialize (engine, bytes) }.ok()\n}\n"}],
     "red": ["deserialize-count"], "must_not": ["deserialize-outside-aegis-wasm"]},
    {"name": "no-deserialize-site",
     "ops": [{"op": "delete", "file": "src/crates/aegis-wasm/src/engine/cwasm.rs"}],
     "red": ["deserialize-count"]},
    {"name": "expectation-guard-weakened",
     "why": "editing the frozen toml below the script's floors is red",
     "expect_ops": [{"op": "replace", "old": "memory_guard_size = 33554432", "new": "memory_guard_size = 0       "}],
     "ops": [
       {"op": "json", "file": "config.json", "set": {"memory_guard_size": 0}},
       {"op": "json", "file": "config-mpk.json", "set": {"memory_guard_size": 0}}],
     "red": ["expect-invalid:memory_guard_size"]},
    {"name": "expectation-threads-feature-added",
     "expect_ops": [{"op": "replace", "old": "  \"call-hook\",\n", "new": "  \"call-hook\",\n  \"threads\",\n"}],
     "red": ["expect-invalid:feature:threads"]}
  ]
}
