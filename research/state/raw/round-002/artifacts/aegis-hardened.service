[Unit]
Description=Aegis web server (hardening baseline)
After=network-online.target
Wants=network-online.target
[Service]
Type=notify
ExecStart=/usr/local/bin/aegis serve --config /etc/aegis/aegis.conf
DynamicUser=yes
StateDirectory=aegis
StateDirectoryMode=0700
RuntimeDirectory=aegis
ConfigurationDirectory=aegis
LogsDirectory=aegis
CacheDirectory=aegis
# network
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=
# fs
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
PrivateUsers=no
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
KeyringMode=private
Delegate=no
# resource
LimitNOFILE=1048576
TasksMax=4096
MemoryMax=80%
Restart=on-failure
RestartSec=2
WatchdogSec=30
[Install]
WantedBy=multi-user.target
